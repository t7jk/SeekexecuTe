# ---------------------------------------------------------------- montowanie
def mount_nas(cfg, gui):
    """Montuje udział sieciowy. gui=True: bez pytania o hasło w terminalu (sudo -n, potem pkexec)."""
    share = cfg["nas_share"].strip()
    if not share.startswith("//"):
        return False, "Share must look like //host/share[/subfolder]."
    try:
        os.makedirs(MOUNT, exist_ok=True)
    except OSError as e:
        return False, "Cannot create folder %s: %s" % (MOUNT, e)
    opts = ["uid=%d" % os.getuid(), "gid=%d" % os.getgid(), "iocharset=utf8"]
    if cfg["smb_version"]:
        opts.append("vers=%s" % cfg["smb_version"])
    if cfg["nas_user"] and os.path.isfile(CRED_FILE):
        opts.append("credentials=%s" % CRED_FILE)
    else:
        opts.append("guest")
    cmd = ["mount.cifs", share, MOUNT, "-o", ",".join(opts)]
    attempts = [["sudo", "-n"], ["pkexec"]] if gui else [["sudo"]]
    for prefix in attempts:
        try:
            r = subprocess.run(prefix + cmd, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, text=True, timeout=90,
                               stdin=subprocess.DEVNULL if gui else None)
        except (OSError, subprocess.TimeoutExpired) as e:
            last = str(e)
            continue
        if r.returncode == 0 and os.path.ismount(MOUNT):
            return True, "Mounted: %s" % share
        last = (r.stderr or "").strip().splitlines()[-1:] or ["mount error"]
        last = last[0]
    return False, "Mount failed: %s" % last


def ensure_mounted():
    if not CFG["mount_nas"]:
        if os.path.isdir(MOUNT):
            return True, ""
        return False, "Archive folder does not exist: %s" % MOUNT
    if os.path.ismount(MOUNT):
        return True, ""
    print("Network drive not mounted - mounting %s ..." % MOUNT)
    ok, msg = mount_nas(CFG, gui=False)
    return ok, "" if ok else msg


# --------------------------------------------------------------------- cache
def rescan(progress=None):
    found = []
    for root, dirs, files in os.walk(MOUNT):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for f in sorted(files):
            if os.path.splitext(f)[1].lower() in DISK_EXT:
                found.append(os.path.relpath(os.path.join(root, f), MOUNT))
        if progress:
            progress(len(found))
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE, "w", encoding="utf-8") as fh:
        fh.write("\n".join(found) + "\n")
    return found


def load_cache():
    with open(CACHE, encoding="utf-8") as fh:
        return [ln.rstrip("\n") for ln in fh if ln.strip()]


