def new_node():
    return {"dirs": {}, "files": [], "count": None}


def build_tree(paths, cats=None):
    root = new_node()
    for p in paths:
        parts = p.split("/")
        node = root
        for d in parts[:-1]:
            node = node["dirs"].setdefault(d, new_node())
        node["files"].append(parts[-1])
    if cats:
        have = set(paths)
        catroot = new_node()
        for code, name in CATEGORY_NAMES.items():
            rels = [r for r in cats.get(code, []) if r in have]
            if not rels:
                continue
            node = new_node()
            node["relmap"] = {}
            for r in sorted(rels):
                label = os.path.basename(r)
                if label in node["relmap"]:     # ta sama nazwa w ST/STX/HD
                    fmt = r.split("/")[-3] if len(r.split("/")) >= 3 else "?"
                    label = "%s  (%s)" % (label, fmt)
                node["relmap"][label] = r
            node["files"] = list(node["relmap"])
            catroot["dirs"][name] = node
        if catroot["dirs"]:
            root["dirs"][CAT_ROOT] = catroot
    return root


def count_disks(node):
    if node["count"] is None:
        node["count"] = len(node["files"]) + sum(count_disks(n) for n in node["dirs"].values())
    return node["count"]


def collapse(node, name):
    while not node["files"] and len(node["dirs"]) == 1:
        (n, sub), = node["dirs"].items()
        name += "/" + n
        node = sub
    return name, node


MAX_FLAT = 50   # więcej plików w folderze => podział na grupy literowe


def _bucket_key(name, plen):
    k = name[:plen].upper()
    if not k or not k[0].isalpha():
        return "0-9"
    return k


def listing(node):
    """Lista pozycji (rodzaj, etykieta, węzeł, wirtualny); liczona raz na węzeł."""
    if "_list" in node:
        return node["_list"]
    items = []
    for name in sorted(node["dirs"], key=lambda n: (n != CAT_ROOT, n.lower())):
        label, sub = collapse(node["dirs"][name], name)
        items.append(("dir", label, sub, False))
    files = sorted(node["files"], key=str.lower)
    if len(files) <= MAX_FLAT:
        items += [("file", f, None, False) for f in files]
    else:
        plen = node.get("plen", 1)
        buckets = {}
        while True:
            buckets = {}
            for f in files:
                buckets.setdefault(_bucket_key(f, plen), []).append(f)
            if len(buckets) > 1 or plen >= 8:
                break
            plen += 1
        for key in sorted(buckets, key=lambda k: (k != "0-9", k)):
            sub = new_node()
            sub["files"] = buckets[key]
            sub["plen"] = plen + 1
            if "relmap" in node:
                sub["relmap"] = node["relmap"]
            items.append(("dir", key, sub, True))
    node["_list"] = items
    return items


def contains(node, name):
    if name in node["files"]:
        return True
    return any(contains(n, name) for n in node["dirs"].values())


# ------------------------------------------------------ opis i okładka (opcj.)
def _variants(stem):
    """Nazwa dyskietki oraz wersja bez (nawiasów) i [nawiasów]."""
    out = [stem]
    stripped = re.sub(r"\s*[\(\[][^\)\]]*[\)\]]", "", stem).strip()
    if stripped and stripped not in out:
        out.append(stripped)
    return out


def _gb_base(rel):
    parts = rel.split("/")
    if "Games" in parts:
        i = len(parts) - 1 - parts[::-1].index("Games")
        if len(parts) >= i + 4:
            return os.path.join(MOUNT, *parts[:i]), parts[i + 2]
    return None, None


def find_description(rel):
    full = os.path.join(MOUNT, rel)
    stem, d = os.path.splitext(os.path.basename(full))[0], os.path.dirname(full)
    cands = [os.path.join(d, stem + e) for e in (".txt", ".nfo", ".diz", ".TXT")]
    base, letter = _gb_base(rel)
    if base:
        for v in _variants(stem):
            cands.append(os.path.join(base, "Extras", "Instructions", letter, v + ".txt"))
    for c in cands:
        if os.path.isfile(c):
            return c
    return None


def find_cover(rel):
    full = os.path.join(MOUNT, rel)
    stem, d = os.path.splitext(os.path.basename(full))[0], os.path.dirname(full)
    cands = [os.path.join(d, stem + e) for e in IMG_EXT]
    base, letter = _gb_base(rel)
    if base:
        for v in _variants(stem):
            for e in IMG_EXT:
                cands.append(os.path.join(base, "Extras", "Boxscans", letter, v + " - front" + e))
        for v in _variants(stem):
            for e in IMG_EXT:
                cands.append(os.path.join(base, "Screenshots", letter, v.replace(" ", "_") + "_1" + e))
    for c in cands:
        if os.path.isfile(c):
            return c
    return None


def read_text(path):
    raw = open(path, "rb").read(120000)
    for enc in ("utf-8", "cp1250", "cp1252"):
        try:
            return raw.decode(enc).replace("\r", "")
        except UnicodeDecodeError:
            pass
    return raw.decode("latin-1", "replace").replace("\r", "")


def load_pixbuf(path):
    pb = GdkPixbuf.Pixbuf.new_from_file(path)
    w, h = pb.get_width(), pb.get_height()
    if max(w, h) > 1400:
        s = 1400.0 / max(w, h)
        pb = pb.scale_simple(int(w * s), int(h * s), GdkPixbuf.InterpType.BILINEAR)
    return pb


def key_is_group_end(key):
    return key in ("_choose", "_rescan")


# ---------------------------------------------------------------- aplikacja
class Browser:
    def __init__(self, root, nas_ok):
        self.root = root
        self.nas_ok = nas_ok
        self.node, self.trail, self.disp = root, [], []
        self.stack = []
        self.cur = self.top = 0
        self.msg = "" if nas_ok else "WARNING: archive unavailable - press c to open settings."
        self.token = 0
        self.timer = None
        self.cache = {}                 # rel -> (opis, pixbuf)
        self.cur_info = (None, None)    # (tekst opisu, pixbuf) dla zaznaczenia
        self.info_loading = False
        self.desc_scroll = 0
        self.line_h = 24
        self.max_scroll = 0
        self.hatari = None
        self.scanning = False
        self.rows = 10
        self.cfg_mode = False
        self.cfg_work = None
        self.cfg_pass = ""
        self.cfg_cur = 0
        self.cfg_edit = None     # indeks edytowanego pola tekstowego
        self.cfg_buf = ""
        self.favs = load_favs()
        self.fav_mode = False
        self.fav_rels = []
        self.other_pos = (0, 0)         # zapamiętana pozycja drugiego widoku
        self.wide = False               # spacja: lista na całą szerokość, prawe panele schowane

        self.win = None
        self.area = None

    # --- okno
    def activate(self, app):
        self.win = Gtk.ApplicationWindow(application=app, title="Atari ST")
        self.win.set_default_size(1280, 720)
        css = Gtk.CssProvider()
        css.load_from_string("window, drawingarea { background: #00DE00; }")
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.area = Gtk.DrawingArea()
        self.area.set_hexpand(True)
        self.area.set_vexpand(True)
        self.area.set_draw_func(self.draw)
        self.win.set_child(self.area)
        key = Gtk.EventControllerKey()
        key.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)   # Tab nie może iść do nawigacji fokusu
        key.connect("key-pressed", self.on_key)
        self.win.add_controller(key)
        wheel = Gtk.EventControllerScroll.new(Gtk.EventControllerScrollFlags.VERTICAL)
        wheel.connect("scroll", self.on_wheel)
        self.win.add_controller(wheel)
        if CFG.get("fullscreen", True):
            self.win.fullscreen()
        else:
            self.win.maximize()
        self.win.present()
        if getattr(self, "open_settings_on_start", False):
            self.open_settings()
            self.msg = "Archive unavailable - set a folder or network drive."
        if os.environ.get("ATARI_MENU_OPEN_SETTINGS"):     # tylko do testów
            self.open_settings()
        goto = os.environ.get("ATARI_MENU_GOTO")      # tylko do testów
        if goto:
            self.goto(goto)
        else:
            self.restore_position()
            self.schedule_info()
        self.win.connect("close-request", self.on_close)

    def on_close(self, win):
        self.save_position()
        return False

    def save_position(self):
        if self.cfg_mode or self.fav_mode:
            return
        sel = self.selection()
        save_state(list(self.disp), sel[1] if sel else None)

    def restore_position(self):
        disp, sel = load_state()
        for label in disp:
            for idx, (kind, lab, sub, virt) in enumerate(listing(self.node)):
                if kind == "dir" and lab == label:
                    self.enter(idx)
                    break
            else:
                break
        if sel is not None:
            for idx, item in enumerate(listing(self.node)):
                if item[1] == sel:
                    self.cur = idx
                    break

    def goto(self, rel):
        parts = rel.split("/")
        name = parts[-1]
        for _ in range(40):
            items = listing(self.node)
            for idx, (kind, label, sub, virt) in enumerate(items):
                if kind == "file" and label == name:
                    self.cur = idx
                    self.schedule_info()
                    return
            for idx, (kind, label, sub, virt) in enumerate(items):
                if kind == "dir" and contains(sub, name) and (
                        virt or label.split("/")[0] in parts):
                    self.enter(idx)
                    break
            else:
                break
        self.schedule_info()

    def enter(self, idx):
        kind, label, sub, virt = listing(self.node)[idx]
        self.stack.append((self.node, self.trail, self.disp, self.cur, self.top))
        if not virt:
            self.trail = self.trail + label.split("/")
        self.disp = self.disp + [label]
        self.node, self.cur, self.top = sub, 0, 0

    # --- zaznaczenie, ładowanie opisu/okładki
    def items(self):
        if self.fav_mode:
            self.fav_rels = sorted(self.favs, key=lambda r: os.path.basename(r).lower())
            return [("file", os.path.basename(r), None, False) for r in self.fav_rels]
        return listing(self.node)

    def selection(self):
        items = self.items()
        if items and 0 <= self.cur < len(items):
            return items[self.cur]
        return None

    def rel_of(self, label):
        relmap = self.node.get("relmap")
        if relmap:
            return relmap.get(label, label)
        return "/".join(self.trail + [label])

    def selected_rel(self):
        sel = self.selection()
        if sel and sel[0] == "file":
            if self.fav_mode:
                return self.fav_rels[self.cur]
            return self.rel_of(sel[1])
        return None

    def schedule_info(self):
        self.token += 1
        self.desc_scroll = 0
        self.cur_info = (None, None)
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = None
        rel = self.selected_rel()
        if rel is None:
            self.info_loading = False
            self.area.queue_draw()
            return
        if rel in self.cache:
            self.cur_info = self.cache[rel]
            self.info_loading = False
        else:
            self.info_loading = True
            self.timer = GLib.timeout_add(120, self.start_load, rel, self.token)
        self.area.queue_draw()

    def start_load(self, rel, token):
        self.timer = None
        threading.Thread(target=self.load_info, args=(rel, token), daemon=True).start()
        return False

    def load_info(self, rel, token):
        text = pb = None
        try:
            d = find_description(rel)
            if d:
                text = read_text(d)
        except Exception:
            pass
        try:
            c = find_cover(rel)
            if c:
                pb = load_pixbuf(c)
        except Exception:
            pass
        GLib.idle_add(self.info_ready, rel, token, text, pb)

    def info_ready(self, rel, token, text, pb):
        self.cache[rel] = (text, pb)
        if token == self.token:
            self.cur_info = (text, pb)
            self.info_loading = False
            self.area.queue_draw()
        return False

    # --- klawisze
    def on_key(self, ctrl, keyval, keycode, state):
        items = self.items()
        n = len(items)
        old = (self.cur, id(self.node), self.fav_mode, len(self.favs))
        K = Gdk
        if self.cfg_mode:
            return self.settings_key(keyval, state)
        if self.scanning:
            return True
        self.msg = ""
        if keyval in (K.KEY_Down, K.KEY_j):
            self.cur = min(self.cur + 1, n - 1)
        elif keyval in (K.KEY_Up, K.KEY_k):
            self.cur = max(self.cur - 1, 0)
        elif keyval == K.KEY_bracketright:
            self.cur = min(self.cur + max(self.rows - 1, 1), n - 1)
        elif keyval == K.KEY_bracketleft:
            self.cur = max(self.cur - max(self.rows - 1, 1), 0)
        elif keyval == K.KEY_comma:
            self.cur = 0
        elif keyval == K.KEY_period:
            self.cur = max(n - 1, 0)
        elif keyval in (K.KEY_Return, K.KEY_KP_Enter):
            self.activate_item()
        elif keyval in (K.KEY_Left, K.KEY_BackSpace):
            if self.fav_mode:
                self.toggle_fav_view()
            elif self.stack:
                self.node, self.trail, self.disp, self.cur, self.top = self.stack.pop()
        elif keyval == K.KEY_Tab:
            self.toggle_fav_view()
        elif keyval == K.KEY_space:
            self.wide = not self.wide
        elif keyval in (K.KEY_a, K.KEY_A):
            self.toggle_favorite()
        elif keyval == K.KEY_minus:
            self.desc_scroll = max(0, self.desc_scroll - 3 * self.line_h)
        elif keyval in (K.KEY_equal, K.KEY_plus):
            self.desc_scroll += 3 * self.line_h
        elif keyval in (K.KEY_c, K.KEY_C):
            self.open_settings()
        elif keyval == K.KEY_Escape:
            self.win.close()
        else:
            return False
        if (self.cur, id(self.node), self.fav_mode, len(self.favs)) != old:
            self.schedule_info()
        self.area.queue_draw()
        return True

    def cycle_preset(self, step):
        global CFG
        i = PRESET_NAMES.index(CFG["preset"]) if CFG["preset"] in PRESET_NAMES else 2
        CFG["preset"] = PRESET_NAMES[(i + step) % len(PRESETS)]
        try:
            save_config(CFG)
        except OSError:
            pass
        self.msg = "Machine: " + " ".join(CFG["preset"].split())

    def toggle_fav_view(self):
        self.cur, self.top, self.other_pos = self.other_pos[0], self.other_pos[1], (self.cur, self.top)
        self.fav_mode = not self.fav_mode

    def toggle_favorite(self):
        rel = self.selected_rel()
        if rel is None:
            self.msg = "Favorites: select a disk (not a folder)."
            return
        if rel in self.favs:
            self.favs.remove(rel)
            self.msg = "Removed from favorites: " + os.path.basename(rel)
        else:
            self.favs.append(rel)
            self.msg = "Added to favorites: " + os.path.basename(rel)
        save_favs(self.favs)
        n = len(self.items())
        self.cur = max(0, min(self.cur, n - 1))

    def on_wheel(self, ctrl, dx, dy):
        self.desc_scroll = max(0, self.desc_scroll + int(dy * 3 * self.line_h))
        self.area.queue_draw()
        return True

    def activate_item(self):
        sel = self.selection()
        if not sel:
            return
        if sel[0] == "dir":
            self.enter(self.cur)
            return
        if self.hatari and self.hatari.poll() is None:
            self.msg = "Hatari is already running."
            return
        if not root_ready():
            self.msg = "Archive unavailable (drive not mounted?). Settings: c"
            return
        rel = self.selected_rel()
        pname, machine, mem, tos = current_preset()
        self.hatari = subprocess.Popen([HA, "-m", machine, "-M", str(mem),
                                        "-t", os.path.join(TOS_DIR, tos),
                                        os.path.join(MOUNT, rel)])
        self.msg = "Started Hatari (%s): %s" % (" ".join(pname.split()), sel[1])
        GLib.timeout_add(700, self.watch_hatari)

    def watch_hatari(self):
        if self.hatari and self.hatari.poll() is None:
            return True
        self.msg = ""
        self.area.queue_draw()
        return False

    def start_rescan(self):
        if not root_ready():
            self.msg = "Cannot scan: archive unavailable. Settings: c"
            return
        self.scanning = True
        self.msg = "Scanning drive..."

        def work():
            def prog(n):
                GLib.idle_add(self.set_msg, "Scanning drive... %d disks" % n)
            paths = rescan(prog)
            GLib.idle_add(self.rescan_done, paths)
        threading.Thread(target=work, daemon=True).start()

    def set_msg(self, m):
        self.msg = m
        self.area.queue_draw()
        return False

    def rescan_done(self, paths):
        self.root = build_tree(paths, load_categories())
        self.node, self.trail, self.disp, self.stack = self.root, [], [], []
        self.fav_mode = False
        self.cur = self.top = 0
        self.cache.clear()
        self.scanning = False
        self.msg = "Cache refreshed: %d disks." % len(paths)
        self.schedule_info()
        return False

    # --- ustawienia
    CFG_ROWS = [
        ("archive_root", "Archive folder", "text"),
        ("_choose", "Choose archive folder...", "action"),
        ("fullscreen", "Full screen", "bool"),
        ("mount_nas", "Mount network drive (NAS)", "bool"),
        ("nas_share", "Network share (//host/share/subfolder)", "text"),
        ("nas_user", "User (empty = guest)", "text"),
        ("nas_pass", "Password", "pass"),
        ("preset", "Hatari machine + TOS", "preset"),
        ("smb_version", "SMB version (empty = auto)", "cycle"),
        ("_mount", "Mount now (test)", "action"),
        ("_rescan", "Rescan archive", "action"),
        ("_save", "Save and apply", "action"),
        ("_cancel", "Cancel", "action"),
    ]

    def open_settings(self):
        self.cfg_work = dict(CFG)
        self.cfg_pass = load_password()
        self.cfg_cur = 0
        self.cfg_edit = None
        self.cfg_mode = True
        self.msg = ""

    def close_settings(self):
        self.cfg_mode = False
        self.cfg_edit = None
        self.cfg_work = None
        self.cfg_pass = ""     # nie trzymamy hasła w pamięci dłużej niż trzeba

    def settings_key(self, keyval, state):
        K = Gdk
        rows = self.CFG_ROWS
        if self.scanning:
            return True
        # --- edycja tekstu
        if self.cfg_edit is not None:
            key = rows[self.cfg_edit][0]
            if keyval in (K.KEY_Return, K.KEY_KP_Enter):
                if key == "nas_pass":
                    self.cfg_pass = self.cfg_buf
                else:
                    self.cfg_work[key] = self.cfg_buf
                self.cfg_edit = None
            elif keyval == K.KEY_Escape:
                self.cfg_edit = None
            elif keyval == K.KEY_BackSpace:
                self.cfg_buf = self.cfg_buf[:-1]
            elif (state & Gdk.ModifierType.CONTROL_MASK) and keyval in (K.KEY_v, K.KEY_V):
                def got(clip, res):
                    try:
                        t = clip.read_text_finish(res)
                    except Exception:
                        t = None
                    if t and self.cfg_edit is not None:
                        self.cfg_buf += t.replace("\n", "").replace("\r", "")
                        self.area.queue_draw()
                self.win.get_clipboard().read_text_async(None, got)
            elif not (state & Gdk.ModifierType.CONTROL_MASK):
                ch = Gdk.keyval_to_unicode(keyval)
                if ch >= 32:
                    self.cfg_buf += chr(ch)
            self.area.queue_draw()
            return True
        # --- nawigacja po polach
        if keyval == K.KEY_Down:
            self.cfg_cur = min(self.cfg_cur + 1, len(rows) - 1)
        elif keyval == K.KEY_Up:
            self.cfg_cur = max(self.cfg_cur - 1, 0)
        elif keyval in (K.KEY_Escape, K.KEY_Left):
            self.close_settings()
        elif keyval in (K.KEY_Return, K.KEY_KP_Enter):
            self.settings_activate()
        else:
            return False
        self.area.queue_draw()
        return True

    def settings_activate(self):
        key, _label, kind = self.CFG_ROWS[self.cfg_cur]
        if kind in ("text", "pass"):
            self.cfg_edit = self.cfg_cur
            self.cfg_buf = self.cfg_pass if kind == "pass" else str(self.cfg_work[key])
        elif kind == "bool":
            self.cfg_work[key] = not self.cfg_work[key]
        elif kind == "preset":
            cur = self.cfg_work[key]
            i = PRESET_NAMES.index(cur) if cur in PRESET_NAMES else 2
            self.cfg_work[key] = PRESET_NAMES[(i + 1) % len(PRESETS)]
        elif kind == "cycle":
            cur = self.cfg_work[key]
            i = SMB_VERSIONS.index(cur) if cur in SMB_VERSIONS else 0
            self.cfg_work[key] = SMB_VERSIONS[(i + 1) % len(SMB_VERSIONS)]
        elif key == "_choose":
            self.choose_folder()
        elif key == "_mount":
            self.settings_mount()
        elif key == "_rescan":
            self.close_settings()
            self.start_rescan()
        elif key == "_save":
            self.settings_save()
        elif key == "_cancel":
            self.close_settings()

    def choose_folder(self):
        if not hasattr(Gtk, "FileDialog"):
            self.msg = "This GTK has no folder chooser - type the path by hand."
            return
        dlg = Gtk.FileDialog()
        dlg.set_title("Choose archive folder")

        def done(d, res):
            try:
                f = d.select_folder_finish(res)
            except Exception:
                return
            if f and f.get_path() and self.cfg_work is not None:
                self.cfg_work["archive_root"] = f.get_path()
                self.cfg_work["mount_nas"] = False   # zwykły folder lokalny
                self.area.queue_draw()
        dlg.select_folder(self.win, None, done)

    def settings_mount(self):
        self.scanning = True
        self.msg = "Mounting..."
        cfg = dict(self.cfg_work)

        def work():
            write_credentials(cfg["nas_user"], self.cfg_pass)
            old = (CFG, MOUNT, CACHE)
            apply_config(cfg)
            if os.path.ismount(MOUNT):
                ok, msg = True, "Already mounted: %s" % MOUNT
            else:
                ok, msg = mount_nas(cfg, gui=True)
            apply_config(old[0])      # test nie zmienia aktywnej konfiguracji
            GLib.idle_add(self.settings_mount_done, msg)
        threading.Thread(target=work, daemon=True).start()

    def settings_mount_done(self, msg):
        self.scanning = False
        self.msg = msg
        self.area.queue_draw()
        return False

    def settings_save(self):
        cfg = dict(self.cfg_work)
        if not cfg["archive_root"].strip():
            self.msg = "Enter the archive folder."
            return
        self.scanning = True
        self.msg = "Saving and applying settings..."
        password = self.cfg_pass

        def work():
            save_config(cfg)
            write_credentials(cfg["nas_user"], password)
            apply_config(cfg)
            ok, msg = True, ""
            if cfg["mount_nas"] and not os.path.ismount(MOUNT):
                ok, msg = mount_nas(cfg, gui=True)
            GLib.idle_add(self.settings_saved, ok, msg)
        threading.Thread(target=work, daemon=True).start()

    def settings_saved(self, ok, msg):
        self.scanning = False
        self.close_settings()
        if CFG.get("fullscreen", True):
            self.win.fullscreen()
        else:
            self.win.unfullscreen()
        self.nas_ok = root_ready()
        self.cache.clear()
        if not self.nas_ok:
            self.root = build_tree([], load_categories())
            self.node, self.trail, self.disp, self.stack = self.root, [], [], []
            self.cur = self.top = 0
            self.msg = msg or "Archive unavailable."
            self.schedule_info()
            return False
        if os.path.isfile(CACHE):
            paths = load_cache()
            self.root = build_tree(paths, load_categories())
            self.node, self.trail, self.disp, self.stack = self.root, [], [], []
            self.fav_mode = False
            self.cur = self.top = 0
            self.msg = "Settings applied (%d disks from cache)." % len(paths)
            self.schedule_info()
        else:
            self.start_rescan()      # nowe archiwum - brak cache, skanuj
        return False

    def draw_settings(self, cr, width, height, lh):
        pad = 14
        self.menubar(cr, width, lh)
        self.window(cr, 6, lh + 14, width - 12, height - lh - 80, "SETTINGS", "")
        pad = 22
        label_w = int(width * 0.46)
        y = lh + 14 + 2 * lh + 10
        for i, (key, label, kind) in enumerate(self.CFG_ROWS):
            if kind == "action":
                value = ""
            elif kind == "bool":
                value = "[x]" if self.cfg_work[key] else "[ ]"
            elif kind == "cycle":
                value = self.cfg_work[key] or "auto"
            elif kind == "preset":
                value = " ".join(self.cfg_work[key].split())
            elif kind == "pass":
                value = "*" * len(self.cfg_pass)
            else:
                value = str(self.cfg_work[key])
            if self.cfg_edit == i:
                value = (("*" * len(self.cfg_buf)) if kind == "pass" else self.cfg_buf) + "_"
            sel = (i == self.cfg_cur)
            if sel:
                cr.set_source_rgb(*INK)
                cr.rectangle(pad - 4, y, width - 2 * pad + 8, lh)
                cr.fill()
            col = PAPER if sel else INK
            gap = 12 if kind != "action" else 0
            if kind == "action":
                self.text(cr, pad, y, "[ %s ]" % label, col, width - 2 * pad)
            else:
                self.text(cr, pad, y, label, col if sel else GRAY, label_w - pad)
                self.text(cr, label_w + gap, y, value, col, width - label_w - gap - pad)
            y += lh + (6 if kind == "action" and key_is_group_end(key) else 0)
        if self.msg:
            self.text(cr, pad, height - 4 * lh - 10, self.msg, INK, width - 2 * pad)
        if self.cfg_edit is not None:
            keys = [("Enter", "Accept"), ("Esc", "Cancel"), ("Ctrl+V", "Paste")]
        else:
            keys = [("\u2191\u2193", "Select field"), ("Enter", "Edit field / change value / run action"), ("Esc", "Close without saving")]
        kh = lh + 2
        bh = self.draw_keys(cr, 0, 0, width - 2 * pad, kh, keys, draw=False) + 8
        self.box(cr, -1, height - bh - 6, width + 2, bh + 7)
        self.draw_keys(cr, pad, height - bh - 2, width - 2 * pad, kh, keys)

    # --- GEM-style decoration (modelled on a TOS 1.0 desktop screenshot)
    HB = 18   # height of the horizontal scrollbar / size box row

    def box(self, cr, x, y, w, h, shadow=False, bw=1):
        """Grey box with a black border of bw px (and optional GEM drop shadow)."""
        if shadow:
            cr.set_source_rgb(*INK)
            cr.rectangle(x + 4, y + 4, w, h)
            cr.fill()
        cr.set_source_rgb(*INK)
        cr.rectangle(x, y, w, h)
        cr.fill()
        cr.set_source_rgb(*PAPER)
        cr.rectangle(x + bw, y + bw, w - 2 * bw, h - 2 * bw)
        cr.fill()

    def arrow(self, cr, cx, cy, angle, size=12):
        """Hollow GEM arrow (up = angle 0), centred on cx, cy."""
        def poly(k):
            hw, sw = 6 - k, 2.5 - k
            top, hh, bot = -size / 2 + k * 0.5, 2.5, size / 2 - k
            return [(0, top), (hw, top + 6 - k), (sw, top + 6 - k), (sw, bot),
                    (-sw, bot), (-sw, top + 6 - k), (-hw, top + 6 - k)]
        cr.save()
        cr.translate(cx, cy)
        cr.rotate(angle)
        for k, col in ((0, INK), (1.6, PAPER)):
            pts = poly(k)
            cr.move_to(*pts[0])
            for pt in pts[1:]:
                cr.line_to(*pt)
            cr.close_path()
            cr.set_source_rgb(*col)
            cr.fill()
        cr.restore()

    def menubar(self, cr, width, lh):
        mh = lh + 4
        cr.set_source_rgb(*INK)
        cr.rectangle(0, 0, width, mh + 2)
        cr.fill()
        cr.set_source_rgb(*PAPER)
        cr.rectangle(0, 0, width, mh)
        cr.fill()
        x = 14
        for name in ("Desk", "File", "View", "Options"):
            self.text(cr, x, 2, name, INK)
            lay = self.layout(cr)
            lay.set_text(name + "     ", -1)
            x += lay.get_pixel_size()[0]
        lay = self.layout(cr)
        lay.set_text("SeekexecuTe", -1)
        self.text(cr, width - lay.get_pixel_size()[0] - 14, 2, "SeekexecuTe", INK)
        return mh + 2

    def window(self, cr, x, y, w, h, title, info=None, lh=None):
        """GEM window: thick border + shadow, closer/fuller boxes, dotted title
        bar, info line, horizontal scrollbar and size box.
        Returns the height of the decorated top part (title + info line)."""
        lh = lh or self.line_h
        th = lh + 4
        self.box(cr, x, y, w, h, shadow=True, bw=2)
        x0, y0, w0 = x + 2, y + 2, w - 4          # inside the border
        cr.set_source_rgb(*INK)
        # title bar: 2px-dot lattice on grey between closer and fuller box,
        # each box set off by a thick black separator (as in TOS 1.0)
        cr.rectangle(x0, y0 + th, w0, 2)
        cr.fill()
        cr.rectangle(x0 + th, y0, 3, th)
        cr.rectangle(x0 + w0 - th - 3, y0, 3, th)
        cr.fill()
        for dy in range(y0 + 3, y0 + th - 3, 4):
            for dx in range(x0 + th + 6, x0 + w0 - th - 7, 4):
                cr.rectangle(dx, dy, 2, 2)
        cr.fill()
        c = th / 2
        # closer box (left): grey, black hourglass/bow-tie (4 wedges to centre)
        cr.set_source_rgb(*PAPER)
        cr.rectangle(x0, y0, th, th)
        cr.fill()
        cr.set_source_rgb(*INK)
        m = 4
        L, R, T, B = x0 + m, x0 + th - m, y0 + m, y0 + th - m
        cx_, cy_ = x0 + c, y0 + c
        for pts in (((L, T), (L, B), (cx_ - 1, cy_)),        # left wedge
                    ((R, T), (R, B), (cx_ + 1, cy_)),        # right wedge
                    ((L + 3, T), (R - 3, T), (cx_, cy_ - 2)),    # top bar
                    ((L + 3, B), (R - 3, B), (cx_, cy_ + 2))):   # bottom bar
            cr.move_to(*pts[0])
            for pt in pts[1:]:
                cr.line_to(*pt)
            cr.close_path()
            cr.fill()
        cr.rectangle(L + 3, T, th - 2 * m - 6, 3)
        cr.rectangle(L + 3, B - 3, th - 2 * m - 6, 3)
        cr.fill()
        # fuller box (right): black corners, grey ring, black dot in centre
        fx = x0 + w0 - th
        cr.set_source_rgb(*PAPER)
        cr.rectangle(fx, y0, th, th)
        cr.fill()
        cr.set_source_rgb(*INK)
        k = 6
        for qx, qy, sx_, sy_ in ((fx + 2, y0 + 2, 1, 1), (fx + th - 2, y0 + 2, -1, 1),
                                 (fx + 2, y0 + th - 3, 1, -1), (fx + th - 2, y0 + th - 3, -1, -1)):
            cr.move_to(qx, qy)
            cr.line_to(qx + sx_ * k, qy)
            cr.line_to(qx, qy + sy_ * k)
            cr.close_path()
            cr.fill()
        cr.arc(fx + c, y0 + c, 3.2, 0, 2 * math.pi)
        cr.fill()
        # title text on a grey plate
        maxw = w0 - 2 * th - 40
        lay = self.layout(cr, maxw)
        lay.set_text(title, -1)
        tw = min(lay.get_pixel_size()[0], maxw)
        tx = x0 + (w0 - tw) // 2
        cr.set_source_rgb(*PAPER)
        cr.rectangle(tx - 8, y0 + 1, tw + 16, th - 1)
        cr.fill()
        self.text(cr, tx, y0 + 2, title, INK, maxw, mid=True)
        top = th + 1
        # info line
        if info is not None:
            ih = lh
            self.text(cr, x0 + 6, y0 + th + 3, info, INK, w0 - 12, mid=True)
            cr.set_source_rgb(*INK)
            cr.rectangle(x0, y0 + th + ih + 1, w0, 2)
            cr.fill()
            top = th + ih + 3
        # bottom: horizontal scrollbar (arrow boxes) + size box
        hb = self.HB
        by = y0 + (h - 4) - hb
        cr.set_source_rgb(*INK)
        cr.rectangle(x0, by - 2, w0, 2)
        cr.fill()
        for bx, ang in ((x0, -math.pi / 2), (x0 + w0 - 2 * hb, math.pi / 2)):
            self.box(cr, bx, by, hb, hb)
            self.arrow(cr, bx + hb / 2, by + hb / 2, ang, 12)
        # size box (bottom right): black field, grey lower-right corner
        sx = x0 + w0 - hb
        cr.set_source_rgb(*INK)
        cr.rectangle(sx, by, hb, hb)
        cr.fill()
        cr.set_source_rgb(*PAPER)
        cr.rectangle(sx + 2, by + 2, hb - 4, hb - 4)
        cr.fill()
        cr.set_source_rgb(*INK)
        cr.move_to(sx + 2, by + 2)
        cr.line_to(sx + hb - 2, by + 2)
        cr.line_to(sx + 2, by + hb - 2)
        cr.close_path()
        cr.fill()
        cr.move_to(sx + hb - 2, by + hb - 7)
        cr.line_to(sx + hb - 2, by + hb - 2)
        cr.line_to(sx + hb - 7, by + hb - 2)
        cr.close_path()
        cr.fill()
        cr.set_source_rgb(*PAPER)
        cr.set_line_width(1.5)
        cr.move_to(sx + hb - 3, by + 4)
        cr.line_to(sx + 4, by + hb - 3)
        cr.stroke()
        return top

    def scrollbar(self, cr, x, y, h, pos, total, visible):
        """GEM vertical scrollbar: arrow boxes, plain grey track, slider."""
        w = 18
        cr.set_source_rgb(*INK)
        cr.rectangle(x, y, 2, h)
        cr.fill()
        for by, ang in ((y, 0), (y + h - w, math.pi)):
            self.box(cr, x + 2, by, w - 2, w)
            self.arrow(cr, x + 2 + (w - 2) / 2, by + w / 2, ang, 12)
        track_y, track_h = y + w, h - 2 * w
        if total > visible and track_h > 8:
            sh = max(10, int(track_h * visible / total))
            sy = track_y + int((track_h - sh) * pos / max(1, total - visible))
        else:
            return w
        self.box(cr, x + 2, sy, w - 2, sh, bw=2)
        return w

    # --- rysowanie
    def layout(self, cr, width=None, wrap=False, mid=False):
        lay = PangoCairo.create_layout(cr)
        fd = Pango.FontDescription(FONT)
        fd.set_absolute_size(FONT_PX * Pango.SCALE)
        lay.set_font_description(fd)
        if width is not None:
            lay.set_width(int(width * Pango.SCALE))
            if wrap:
                lay.set_wrap(Pango.WrapMode.WORD_CHAR)
            else:
                lay.set_ellipsize(Pango.EllipsizeMode.MIDDLE if mid
                                  else Pango.EllipsizeMode.END)
        return lay

    def draw_keys(self, cr, x, y, maxw, lh, keys, draw=True):
        """Key bar: [key] caps (inverse video) + label. Wraps; returns height."""
        lay = self.layout(cr)
        cx, cy, gap = x, y, 14
        for key, label in keys:
            lay.set_text(key, -1)
            kw = lay.get_pixel_size()[0] + 12
            lay.set_text(label, -1)
            lw = lay.get_pixel_size()[0]
            if cx > x and cx + kw + 6 + lw > x + maxw:
                cx, cy = x, cy + lh + 6
            if draw:
                cr.set_source_rgb(*INK)
                cr.rectangle(cx, cy, kw, lh)
                cr.fill()
                cr.set_source_rgb(*PAPER)
                cr.rectangle(cx + 1, cy + 1, kw - 2, lh - 2)
                cr.set_line_width(1)
                cr.stroke()
                cr.set_source_rgb(*INK)
                cr.rectangle(cx + 2, cy + 2, kw - 4, lh - 4)
                cr.fill()
                self.text(cr, cx + 6, cy + (lh - self.glyph_h) // 2, key, PAPER)
                self.text(cr, cx + kw + 6, cy + (lh - self.glyph_h) // 2, label, INK)
            cx += kw + 6 + lw + gap
        return cy + lh - y

    def item_text(self, idx, item):
        kind, label, sub, _v = item
        if kind == "dir":
            return "[%s]  (%d)" % (label, count_disks(sub))
        rel_i = self.fav_rels[idx] if self.fav_mode else self.rel_of(label)
        return ("* " if rel_i in self.favs else "  ") + label

    def names_width(self, cr, items):
        """Szerokość (px) najdłuższej pozycji listy."""
        if not items:
            return 0
        lay = self.layout(cr)
        longest = max((self.item_text(i, it) for i, it in enumerate(items)), key=len)
        lay.set_text(longest, -1)
        return lay.get_pixel_size()[0]

    def text(self, cr, x, y, s, color=INK, width=None, wrap=False, mid=False):
        lay = self.layout(cr, width, wrap, mid)
        lay.set_text(s, -1)
        cr.set_source_rgb(*color)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)
        return lay.get_pixel_size()[1]

    def draw(self, area, cr, width, height):
        cr.set_source_rgb(*DESKTOP)
        cr.paint()
        pad = 10
        lay = self.layout(cr)
        lay.set_text("Ag", -1)
        lh = lay.get_pixel_size()[1] + 4
        self.line_h = lh
        self.glyph_h = lay.get_pixel_size()[1]
        if self.cfg_mode:
            self.draw_settings(cr, width, height, lh)
            return
        mh = self.menubar(cr, width, lh)

        # key bar at the bottom
        # label tiers: short -> long; use the longest set that fits in 3 rows
        tiers = [
            [("\u2191\u2193", "Move"), ("Enter", "Open / run"), ("\u2190", "Back"),
             ("[ ]", "Page"), (", .", "First / last"), ("Space", "Wide / preview"),
             ("- =", "Scroll text"), ("a", "Favorite"), ("Tab", "Favorites"),
             ("c", "Settings"), ("Esc", "Quit")],
            [("\u2191\u2193", "Move selection"), ("Enter", "Open folder or run disk"),
             ("\u2190", "Go back"), ("[ ]", "Page up and down"),
             (", .", "First or last item"), ("Space", "Wide list or preview"),
             ("- =", "Scroll description"), ("a", "Add or remove favorite"),
             ("Tab", "Show favorites"), ("c", "Open settings"), ("Esc", "Quit program")],
            [("\u2191\u2193", "Move selection up and down"),
             ("Enter", "Open folder or run disk"), ("\u2190", "Go back one level"),
             ("[ ]", "Page up and page down"), (", .", "Go to first or last item"),
             ("Space", "Wide list or cover preview"), ("- =", "Scroll description text"),
             ("a", "Add or remove favorite"), ("Tab", "Show favorites or all disks"),
             ("c", "Open settings"), ("Esc", "Quit program")],
        ]
        kh = lh + 2
        keys = tiers[0]
        for t in reversed(tiers):
            if self.draw_keys(cr, 0, 0, width - 2 * pad, kh, t, draw=False) <= 3 * kh + 12:
                keys = t
                break
        help_h = self.draw_keys(cr, 0, 0, width - 2 * pad, kh, keys, draw=False) + 8
        self.box(cr, -1, height - help_h - pad, width + 2, help_h + pad + 1)
        self.draw_keys(cr, pad, height - help_h - pad + 4, width - 2 * pad, kh, keys)

        # windows live between the menu bar and the key bar
        win_top = mh + 10
        win_bot = height - help_h - pad - 12
        items = self.items()
        need = self.names_width(cr, items) + 2 * pad + 40
        min_w = int(width * 0.30)            # never narrower than ~30% of the screen
        if self.wide:
            left_w = max(min(need, width - 60), min_w)
        else:
            left_w = int(width * 0.42)
        right_x = left_w + 6
        right_w = width - right_x - 12

        # left window: file manager
        path = "/" + "/".join(self.disp) if self.disp else "/"
        if self.fav_mode:
            path = "FAVORITES (%d)" % len(self.favs)
        cur_item = items[self.cur] if items and 0 <= self.cur < len(items) else None
        if self.msg:
            info = self.msg
        elif cur_item:
            info = "%d / %d" % (self.cur + 1, len(items))
            if cur_item[0] == "file":
                full = self.fav_rels[self.cur] if self.fav_mode else cur_item[1]
                info += "   " + full
        else:
            info = "0 items"
        wx, ww = 8, left_w - 8
        top_h = self.window(cr, wx, win_top, ww, win_bot - win_top, path, info)
        list_top = win_top + top_h + 3
        content_bot = win_bot - self.HB - 3
        sbw = 18
        lx = wx + 6
        lw = ww - sbw - 8
        list_h = content_bot - list_top
        self.rows = max(1, int(list_h // lh))
        self.cur = max(0, min(self.cur, len(items) - 1)) if items else 0
        if self.cur < self.top:
            self.top = self.cur
        if self.cur >= self.top + self.rows:
            self.top = self.cur - self.rows + 1
        for i in range(self.rows):
            idx = self.top + i
            if idx >= len(items):
                break
            y = list_top + i * lh
            s = self.item_text(idx, items[idx])
            if idx == self.cur:
                cr.set_source_rgb(*INK)
                cr.rectangle(wx + 1, y, ww - sbw - 2, lh)
                cr.fill()
                self.text(cr, lx, y + 2, s, PAPER, lw - 4, mid=True)
            else:
                self.text(cr, lx, y + 2, s, INK, lw - 4, mid=True)
        if not items:
            self.text(cr, lx, list_top, "(no favorites - press a on a disk)"
                      if self.fav_mode else "(empty)", GRAY)
        self.scrollbar(cr, wx + ww - sbw - 1, list_top - 3, list_h + 3,
                       self.top, len(items), self.rows)

        # right window: cover (top) and description (bottom)
        if right_w < 120:
            return
        sel = self.selection()
        text, pb = self.cur_info
        hidden = self.wide or not sel
        title = "Preview" if hidden else sel[1]
        rinfo = None
        if not hidden and sel[0] == "file" and self.max_scroll > 0:
            rinfo = "- = / wheel: scroll description (%d%%)" % int(
                100 * self.desc_scroll / self.max_scroll)
        elif not hidden and sel[0] == "dir":
            rinfo = "Folder - %d disks inside" % count_disks(sel[2])
        elif not hidden:
            rinfo = "Cover and description"
        else:
            rinfo = ""
        rtop = self.window(cr, right_x, win_top, right_w, win_bot - win_top, title, rinfo)
        rx = right_x + 8
        rw = right_w - sbw - 12
        top_y = win_top + rtop + 6
        avail_h = content_bot - top_y
        if hidden:
            self.text(cr, rx, top_y + 4, "Nothing to display.\n\nPress SPACE to show or hide the preview.",
                      GRAY, right_w - 16, wrap=True)
            self.scrollbar(cr, right_x + right_w - sbw - 1, win_top + rtop, content_bot - win_top - rtop + 3,
                           0, 1, 1)
            return
        cover_h = int(avail_h * 0.5)
        sb_pos, sb_total, sb_vis = 0, 1, 1
        if sel[0] == "dir":
            n = count_disks(sel[2])
            self.text(cr, rx, top_y, "Folder: %s" % sel[1], INK, rw)
            self.text(cr, rx, top_y + lh, "Disks inside: %d" % n, GRAY, rw)
        else:
            if pb is not None:
                pw, ph = pb.get_width(), pb.get_height()
                s = min(rw / pw, cover_h / ph, 3.0)
                dx = rx + (rw - pw * s) / 2
                cr.save()
                cr.translate(dx, top_y)
                cr.scale(s, s)
                Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
                cr.paint()
                cr.restore()
                cr.set_source_rgb(*INK)
                cr.set_line_width(1)
                cr.rectangle(dx - 0.5, top_y - 0.5, pw * s + 1, ph * s + 1)
                cr.stroke()
            else:
                msg = "(loading...)" if self.info_loading else "(no cover)"
                self.text(cr, rx, top_y, msg, GRAY, rw)
            ty = top_y + cover_h + 8
            cr.set_source_rgb(*INK)
            cr.rectangle(right_x + 1, ty - 4, right_w - 2, 1)
            cr.fill()
            if text:
                cr.save()
                cr.rectangle(rx, ty, rw, content_bot - ty)
                cr.clip()
                lay = self.layout(cr, rw, wrap=True)
                lay.set_text(text, -1)
                total = lay.get_pixel_size()[1]
                self.max_scroll = max(0, total - (content_bot - ty))
                self.desc_scroll = max(0, min(self.desc_scroll, self.max_scroll))
                cr.set_source_rgb(*INK)
                cr.move_to(rx, ty - self.desc_scroll)
                PangoCairo.show_layout(cr, lay)
                cr.restore()
                sb_pos, sb_total, sb_vis = self.desc_scroll, self.max_scroll + (content_bot - ty), content_bot - ty
            else:
                msg = "(loading...)" if self.info_loading else "(no description)"
                self.text(cr, rx, ty, msg, GRAY, rw)
        self.scrollbar(cr, right_x + right_w - sbw - 1, win_top + rtop, content_bot - win_top - rtop + 3,
                       sb_pos, sb_total, sb_vis)


def main():
    force = "--rescan" in sys.argv[1:] or "--rescal" in sys.argv[1:]
    apply_config(load_config())
    nas_ok, err = ensure_mounted()
    if err:
        print(err)
    nas_ok = nas_ok and root_ready()
    paths = []
    if nas_ok and (force or not os.path.isfile(CACHE)):
        print("Scanning %s (a few minutes on a slow link)..." % MOUNT)
        paths = rescan(lambda n: print("\r%d disks..." % n, end="", flush=True))
        print("\nCache saved: %d disks." % len(paths))
    elif os.path.isfile(CACHE):
        paths = load_cache()

    browser = Browser(build_tree(paths, load_categories()), nas_ok)
    browser.open_settings_on_start = not nas_ok and not paths
    app = Gtk.Application(application_id="local.atari.menu")
    app.connect("activate", browser.activate)
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())
