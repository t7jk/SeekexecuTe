def load_password():
    try:
        for ln in open(CRED_FILE, encoding="utf-8"):
            if ln.startswith("password="):
                return ln[len("password="):].rstrip("\n")
    except OSError:
        pass
    return ""


def write_credentials(user, password):
    """Plik z danymi logowania, tylko do odczytu przez właściciela (0600)."""
    os.makedirs(os.path.dirname(CRED_FILE), exist_ok=True)
    if not user:
        try:
            os.remove(CRED_FILE)
        except OSError:
            pass
        return
    fd = os.open(CRED_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("username=%s\npassword=%s\n" % (user, password))


def apply_config(cfg):
    """Ustawia globalne MOUNT i CACHE na podstawie konfiguracji."""
    global CFG, MOUNT, CACHE
    CFG = dict(cfg)
    MOUNT = os.path.expanduser(cfg["archive_root"]).rstrip("/") or "/"
    if MOUNT == LEGACY_ROOT and os.path.isfile(LEGACY_CACHE):
        CACHE = LEGACY_CACHE
    else:
        import hashlib
        h = hashlib.sha1(MOUNT.encode()).hexdigest()[:10]
        CACHE = os.path.expanduser("~/.cache/SeekexecuTe/index-%s.txt" % h)


def root_ready():
